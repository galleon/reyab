# ---------------------------------------------------------------------------
# Copy to .env and adjust.  `docker compose` reads it automatically.
# ---------------------------------------------------------------------------

# --- Images -----------------------------------------------------------------
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.11-py3
ENVOY_IMAGE=envoyproxy/envoy:v1.35-latest

# --- Open-source model A (the "bigger" one; what the router picks for hard prompts)
OSS_A_NAME=qwen3-coder                       # name VS Code sees
OSS_A_HF_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
OSS_A_GPU_UTIL=0.40                          # GB10 has unified memory: keep A+B < ~0.85
OSS_A_MAX_LEN=65536
OSS_A_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser qwen3_coder

# --- Open-source model B ------------------------------------------------------
OSS_B_NAME=gpt-oss
OSS_B_HF_ID=openai/gpt-oss-20b
OSS_B_GPU_UTIL=0.30
OSS_B_MAX_LEN=65536
OSS_B_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser openai

HF_TOKEN=                                    # needed only for gated models

# --- Anthropic (shadow + judge) ----------------------------------------------
ANTHROPIC_API_KEY=
SHADOW_MODEL=claude-opus-5-5
SHADOW_EFFORT=high                           # low|medium|high|xhigh|max (Opus 5.5 default is medium)
SHADOW_RATE=1.0                              # fraction of chat turns shadowed to Opus (0..1)
SHADOW_MAX_CONCURRENCY=8
JUDGE_MODEL=claude-opus-5-5

# --- Blind voting page (http://<host>:8080/arena) ----------------------------
ARENA_SCOPE=team                             # team = people review their own team's prompts; all = everyone's

# --- Router ("auto" virtual model; hidden from /v1/models) -------------------
ENABLE_AUTO=0                                # 1 = clients may send model="auto"
AUTO_ROUTER=vsr                              # vsr = vLLM Semantic Router (policy: services/semantic-router/config.yaml.tmpl)
                                             # nvidia = NVIDIA classifier threshold below
VSR_IMAGE=ghcr.io/vllm-project/semantic-router/vllm-sr:v0.4.0
ROUTER_COMPLEXITY_THRESHOLD=0.22             # AUTO_ROUTER=nvidia only: >= threshold -> model A

# --- Ports ------------------------------------------------------------------
GATEWAY_PORT=8080                            # what VS Code talks to
EVAL_PORT=8081                               # organizer-only: exposes all 3 models (bound to 127.0.0.1)

# --- Observability (docker compose --profile observability up -d) -----------
PROMETHEUS_PORT=9090                         # bound to 127.0.0.1
GRAFANA_PORT=3000                            # bound to 127.0.0.1; anonymous read-only, admin below
GRAFANA_ADMIN_PASSWORD=admin
